HOST=0.0.0.0
NODE_ENV=production
PORT=8000
HTTP_SECURE_OPTION=true

ACCESS_CONTROL_ORIGINS=https://flick.dhvanitm.in,https://flick-admin.dhvanitm.in,http://localhost:3000
COOKIE_DOMAIN=dhvanitm.in

DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
REDIS_URL=redis://<user>:<password>@<host>:6379
CACHE_DRIVER=memory
CACHE_TTL=60
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
ACCESS_TOKEN_SECRET=<replace-me>
REFRESH_TOKEN_SECRET=<replace-me>

GOOGLE_OAUTH_CLIENT_ID=<replace-me>
GOOGLE_OAUTH_CLIENT_SECRET=<replace-me>
GMAIL_APP_USER=<replace-me>
GMAIL_APP_PASS=<replace-me>
MAILTRAP_TOKEN=<replace-me>
MAIL_PROVIDER=gmail

SERVER_BASE_URI=https://flick-api.dhvanitm.in
MODERATION_URL=http://moderation:8080
MAIL_FROM=noreply@dhvanitm.in
EMAIL_ENCRYPTION_KEY=<64-hex-chars>
EMAIL_SECRET=<replace-me>
HMAC_SECRET=<replace-me>
ADMIN_EMAIL=admin@flick.com
ADMIN_PASSWORD=<replace-me>
BETTER_AUTH_URL=https://flick-api.dhvanitm.in
BETTER_AUTH_SECRET=<replace-me>

CLOUDINARY_CLOUD_NAME=<replace-me>
CLOUDINARY_API_KEY=<replace-me>
CLOUDINARY_API_SECRET=<replace-me>
CLOUDINARY_UPLOAD_FOLDER=flick/colleges
